APP_NAME=PromptToInvoice
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=prompt_to_invoice
DB_USERNAME=postgres
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="invoices@prompttoinvoice.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false
# R2: https://<account>.r2.cloudflarestorage.com, region auto; AWS_URL is the public bucket URL.
AWS_ENDPOINT=
AWS_URL=

VITE_APP_NAME="${APP_NAME}"

FRONTEND_URL=http://localhost:3000

# Stripe (Laravel Cashier). Webhook endpoint: {APP_URL}/stripe/webhook
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
CASHIER_CURRENCY=usd
# Recurring monthly prices; also editable per plan in the admin portal.
STRIPE_PRICE_PROFESSIONAL=
STRIPE_PRICE_BUSINESS=

# AI invoice drafts. Set the keys you have; pick the provider in the admin portal.
AI_PROVIDER=anthropic
AI_FALLBACK_PROVIDER=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
ANTHROPIC_EFFORT=low
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-astra
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-4-maverick
AI_CUSTOM_LABEL=
AI_CUSTOM_BASE_URL=
AI_CUSTOM_API_KEY=
AI_CUSTOM_MODEL=
AI_CUSTOM_JSON_MODE=schema

# Hops between the Next.js server and this API (comma-separated IPs/CIDRs),
# so rate limits see the visitor. See config/trustedproxy.php.
TRUSTED_PROXIES=
# API token lifetime in minutes (default 30 days).
SANCTUM_EXPIRATION=43200
# Business logos: public (local, needs storage:link) or s3 (S3 / Cloudflare R2).
LOGO_DISK=public
